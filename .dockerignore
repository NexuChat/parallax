# Cloud Build uploads this directory before it reads the Dockerfile, so anything
# left here is paid for on every build. The virtualenv alone is 327MB, and none
# of it belongs in an image that installs its own dependencies.
.venv/
.git/
.gitignore
runs/
demo/
*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.playwright-mcp/
tests/
docs/
*.png
# console/runs holds the published sweeps the front page and live wall read, so
# it belongs in the image. Its per-role storage states do not: they are session
# credentials, and every file under a run directory is served unauthenticated.
console/runs/*/storage-*.json
